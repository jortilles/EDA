# Copia este archivo como ".env" (no se versiona) y ajusta los valores.

# URL base de la API (backend Express, puerto fijo 8666 en lib/server.ts)
API_BASE_URL=http://localhost:8666

# URL base de la app Angular (ng serve)
APP_BASE_URL=http://localhost:4200

# Credenciales de un usuario administrador YA EXISTENTE en la base de datos de
# desarrollo, usadas UNA SOLA VEZ al arrancar la suite para crear un usuario
# de test dedicado (no se reutilizan en ningun test). No compartas este archivo.
BOOTSTRAP_ADMIN_EMAIL=pruebaAdmin
BOOTSTRAP_ADMIN_PASSWORD=pruebaAdmin

# Prefijo con el que se etiquetan TODOS los datos creados por la suite
# (usuarios, dashboards, datasources, etc.) para poder localizarlos y
# limpiarlos automaticamente al terminar. Cambialo si corres varias suites
# en paralelo contra la misma base de datos.
TEST_RUN_PREFIX=PWTEST

# Si es "true", eda_api se arranca automaticamente (npm run dev) cuando no
# esta ya escuchando en API_BASE_URL. Si ya lo tienes corriendo, se reutiliza.
AUTO_START_API=true
